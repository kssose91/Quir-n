[Unit]
Description=Quirón Brain — índice, grafo y API, con sus almacenes
Documentation=file:///home/KSSOSE/Quirón/README.md
# Necesita el socket de Docker para gestionar los contenedores de los almacenes.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/KSSOSE/Quirón/Quirón/quiron-brain
EnvironmentFile=%h/.config/quiron/quiron-brain.env

# Los almacenes viven exactamente mientras vive la aplicación:
# se levantan justo antes del brain y se paran justo después.
ExecStartPre=/home/KSSOSE/Quirón/scripts/quiron-stores.sh up
ExecStart=/home/KSSOSE/Quirón/Quirón/quiron-brain/target/release/quiron-brain
ExecStopPost=/home/KSSOSE/Quirón/scripts/quiron-stores.sh down

# La app es un todo: si el brain cae, cae con sus almacenes. El editor lo
# relanza con `systemctl --user start quiron-brain`. Sin auto-reinicio para no
# reciclar los contenedores en bucle.
Restart=no
TimeoutStartSec=180
TimeoutStopSec=60

# Sin sección [Install] a propósito: este servicio NO se habilita al arranque.
# Se activa a demanda (el editor, o `systemctl --user start quiron-brain`).
