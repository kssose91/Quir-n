# ONNX Runtime's pinned archive uses C23 functions (glibc >=2.38).
# Ubuntu 24.04 supplies glibc 2.39 and the Python 3.12 installer baseline.
FROM ubuntu:24.04@sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev cmake ca-certificates python3 git curl \
    libxkbcommon0 libxkbcommon-x11-0 libwayland-client0 libx11-xcb1 libxcursor1 libxi6 libvulkan1 \
    xvfb xauth xdotool \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/rust/bin:${PATH}"
