# Quiron current-machine profile
# Target topology:
#   - RTX 3090 24 GB  -> worker_llm
#   - RTX 5070 Ti 16G -> semantic_ia_local
#
# Copy this to .env.local and adjust secrets and model names as needed.

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
QUIRON_PORT=8766
QUIRON_DATA=/home/kssose/Quirón/Quirón/quiron-brain/data
QUIRON_VERTEX_GATEWAY_PATH=/home/kssose/Quirón/Quirón/vertex-gateway/target/release/vertex-gateway

# Recommended in any non-throwaway setup
# QUIRON_REQUIRE_AUTH=true
# QUIRON_API_TOKEN=change-me

# -----------------------------------------------------------------------------
# Planner route
# Keep this remote or point it to a separate local server if/when needed.
# -----------------------------------------------------------------------------
# QUIRON_LLM_ENDPOINT_PRIMARY=http://127.0.0.1:8080
# QUIRON_LLM_MODEL_PRIMARY=gpt-5.4
# QUIRON_LLM_TIMEOUT_PRIMARY_SECS=300

# -----------------------------------------------------------------------------
# Worker route
# Run the local worker server pinned to the RTX 3090 on port 8081.
# Estado recomendado hoy: experimental, no canónico para memoria.
# Example topology:
#   CUDA_VISIBLE_DEVICES=0 <worker-server> --port 8081
# Optional for the unified startup script:
#   QUIRON_WORKER_CMD='/home/kssose/Quirón/scripts/arranque_ollama_3090.sh'
#   QUIRON_WORKER_CUDA_VISIBLE_DEVICES='GPU-aee4eb35-5480-815d-cd02-393630e8fab2'
# -----------------------------------------------------------------------------
# Estado actual: worker local retirado hasta migrar a SGLang.
# QUIRON_GATEWAY_BACKEND_WORKER=openai_compatible
# QUIRON_LLM_ENDPOINT_WORKER=http://127.0.0.1:8081
# QUIRON_LLM_MODEL_WORKER=<sglang-model>
# QUIRON_LLM_TIMEOUT_WORKER_SECS=600
# QUIRON_LLM_GATEWAY_TIMEOUT_SECS=660
# QUIRON_LLM_TEMPERATURE_WORKER=0
# QUIRON_ENABLE_ENRICHMENT_WORKER=true
# QUIRON_ENRICHMENT_INTERVAL_SECS=30
# QUIRON_ENRICHMENT_BATCH_SIZE=3
# QUIRON_ENABLE_DISTILLATION_WORKER=false
# QUIRON_DISTILLATION_INTERVAL_SECS=60
# QUIRON_START_WORKER=false
# QUIRON_WORKER_CMD=/home/kssose/Quirón/scripts/arranque_ollama_3090.sh
# QUIRON_WORKER_CUDA_VISIBLE_DEVICES=GPU-aee4eb35-5480-815d-cd02-393630e8fab2

# -----------------------------------------------------------------------------
# semantic_ia_local
# Dedicated semantic service for the RTX 5070 Ti on port 8091.
# -----------------------------------------------------------------------------
QUIRON_SEMANTIC_IA_LOCAL_ENDPOINT=http://127.0.0.1:8091
QUIRON_SEMANTIC_IA_LOCAL_PORT=8091
QUIRON_SEMANTIC_IA_LOCAL_MODEL_EMBED=BAAI/bge-m3
QUIRON_SEMANTIC_IA_LOCAL_MODEL_RERANK=rozgo/bge-reranker-v2-m3
QUIRON_SEMANTIC_IA_LOCAL_TIMEOUT_SECS=600
# QUIRON_START_SEMANTIC_IA_LOCAL=true
# QUIRON_SEMANTIC_CUDA_VISIBLE_DEVICES=GPU-10ee98c6-1311-3866-d602-734c2b318be4

# Optional dedicated overrides for internal semantic workers
# QUIRON_LLM_MODEL_ENRICHER=<sglang-model>
# QUIRON_LLM_MODEL_DISTILLER=gpt-5.4

# -----------------------------------------------------------------------------
# Semantic memory
# Note: Qdrant stays local/canonical inside the Quiron node.
# `SEMANTIC_BACKEND=remote` means embeddings/rerank move to semantic_ia_local.
# Esta es la base recomendada para esta maquina.
# -----------------------------------------------------------------------------
SEMANTIC_BACKEND=remote
QDRANT_URL=http://127.0.0.1:6334
QDRANT_COLLECTION=quiron_events
EMBED_MODEL=BAAI/bge-m3
SEMANTIC_MIN_THRESHOLD=0.20
SEMANTIC_HIGH_CONFIDENCE=0.50
SEMANTIC_REMOTE_URL=http://127.0.0.1:8091
# SEMANTIC_REMOTE_TIMEOUT_SECS=600

# -----------------------------------------------------------------------------
# Graph memory
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Operational notes
# - Tratar `semantic_ia_local` en la 5070 Ti como base canonica local.
# - Mantener `worker_llm` como experimental hasta validar mejor su ajuste de VRAM.
# - Treat port 8091 as the semantic_ia_local port.
# - Pin semantic_ia_local to the 5070 Ti with CUDA_VISIBLE_DEVICES or the UUID above.
# - The unified launcher lives at /home/kssose/Quirón/scripts/arranque_unificado_quiron.sh
