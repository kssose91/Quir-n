# Quiron LLM routing (vertex-gateway)
# Copy to .env.local (or export in your shell/systemd unit).

# Optional base endpoint fallback
# QUIRON_LLM_ENDPOINT=http://127.0.0.1:8080

# Optional explicit path to the local vertex-gateway binary
# QUIRON_VERTEX_GATEWAY_PATH=/home/kssose/Quirón/Quirón/vertex-gateway/target/release/vertex-gateway

# Primary route (planner/default)
QUIRON_LLM_ENDPOINT_PRIMARY=http://127.0.0.1:8080
QUIRON_LLM_MODEL_PRIMARY=your-primary-model
# Optional for providers that require auth (OpenAI-compatible)
# QUIRON_LLM_API_KEY_PRIMARY=sk-...
# QUIRON_LLM_API_KEY_PRIMARY_FILE=/home/kssose/.config/quiron/primary_api_key
# QUIRON_LLM_TIMEOUT_PRIMARY_SECS=300

# Worker route (delegated tasks only)
QUIRON_LLM_ENDPOINT_WORKER=http://127.0.0.1:8081
QUIRON_LLM_MODEL_WORKER=your-worker-model
# QUIRON_LLM_API_KEY_WORKER=sk-...
# QUIRON_LLM_API_KEY_WORKER_FILE=/home/kssose/.config/quiron/worker_api_key
# QUIRON_LLM_TIMEOUT_WORKER_SECS=300

# Optional semantic IA local service (RTX 5070 Ti)
# QUIRON_SEMANTIC_IA_LOCAL_ENDPOINT=http://127.0.0.1:8091
# QUIRON_SEMANTIC_IA_LOCAL_PORT=8091
# QUIRON_SEMANTIC_IA_LOCAL_MODEL_EMBED=BAAI/bge-m3
# QUIRON_SEMANTIC_IA_LOCAL_MODEL_RERANK=rozgo/bge-reranker-v2-m3
# QUIRON_SEMANTIC_IA_LOCAL_TIMEOUT_SECS=600

# Optional backend switch (default: openai-compatible endpoint mode)
# QUIRON_GATEWAY_BACKEND=openclaw
# QUIRON_OPENCLAW_CMD=/home/kssose/miniforge3/bin/openclaw
# QUIRON_OPENCLAW_AGENT_PRIMARY=main
# QUIRON_OPENCLAW_AGENT_WORKER=main
# QUIRON_OPENCLAW_THINKING=minimal
# QUIRON_OPENCLAW_LOCAL=false

# Legacy compatibility (optional)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Semantic backend selection
# Default: inprocess (local embeddings + Qdrant inside quiron-brain)
# Remote means semantic compute on semantic-ia-local, while Qdrant stays local.
# Semantic backend options: inprocess | remote
# SEMANTIC_BACKEND=inprocess
# SEMANTIC_REMOTE_URL=http://127.0.0.1:8091
# SEMANTIC_REMOTE_TIMEOUT_SECS=120
# SEMANTIC_REMOTE_TOKEN=...

# Secure file workflow (recommended):
# mkdir -p /home/kssose/.config/quiron
# printf '%s' 'sk-...' > /home/kssose/.config/quiron/primary_api_key
# chmod 600 /home/kssose/.config/quiron/primary_api_key
