SEMANTIC_IA_BIND_ADDR=127.0.0.1:8091
SEMANTIC_IA_DEVICE_LABEL=RTX 5070 Ti
SEMANTIC_IA_CUDA_DEVICE_ID=0
SEMANTIC_IA_EXECUTION_PROVIDERS=cuda,cpu
SEMANTIC_IA_EMBED_MODEL=BAAI/bge-m3
SEMANTIC_IA_RERANK_MODEL=rozgo/bge-reranker-v2-m3
SEMANTIC_IA_MODEL_CACHE_DIR=/home/kssose/.cache/semantic-ia-local
SEMANTIC_IA_SHOW_DOWNLOAD_PROGRESS=false
SEMANTIC_IA_WARMUP=false
SEMANTIC_IA_MAX_EMBED_BATCH_SIZE=128
SEMANTIC_IA_MAX_RERANK_BATCH_SIZE=32

# Compatible aliases consumed from the Quiron side if you prefer one shared env:
# QUIRON_SEMANTIC_IA_LOCAL_ENDPOINT=http://127.0.0.1:8091
# QUIRON_SEMANTIC_IA_LOCAL_PORT=8091
# QUIRON_SEMANTIC_IA_LOCAL_MODEL_EMBED=BAAI/bge-m3
# QUIRON_SEMANTIC_IA_LOCAL_MODEL_RERANK=rozgo/bge-reranker-v2-m3
